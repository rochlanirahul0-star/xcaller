# XCaller runtime
PORT=3910
HOST=0.0.0.0
XC_DATA_DIR=./data

# Optional: Web Push keys (create with: npx web-push generate-vapid-keys)
# XC_VAPID_FILE=./data/vapid.json

# Optional: TURN relay for calls between mobile networks
# XC_TURN_FILE=./data/turn.json
# or:
# TURN_HOST=turn.example.com
# TURN_SECRET=change-me
